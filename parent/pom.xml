        <filtering>true</filtering>
      </testResource>
      <testResource>
        <directory>${integrationSourceDirectory}/java</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </testResource>
      <testResource>
        <directory>${integrationSourceDirectory}/resources</directory>
        <filtering>true</filtering>
      </testResource>
    </testResources>
